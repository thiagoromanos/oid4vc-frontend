EXTERNAL_FRONTEND_PORT=3550
NETWORK_NAME=demo_default
NETWORK_EXTERNAL=true

# ── Auth-Server defaults (optional) ──────────────────────────────────────────
# When set, these values pre-populate the Config document on first start and
# fill in any fields left blank in the UI.  UI values always take precedence
# once explicitly saved.
# AUTH_SERVER_URL=http://auth-server:9000
# AUTH_SERVER_ADMIN_TOKEN=adminsecrettoken
# AUTH_SERVER_PRIVATE_URL=http://auth-server:9001
# TENANT_SECRET=admininternaltoken
#
# Option A — set the public URL directly:
# AUTH_SERVER_PUBLIC_URL=https://your-ngrok-url.io
#
# Option B — discover it automatically from a running ngrok agent at startup:
# TUNNEL_ENDPOINT=http://ngrok:4040
# TUNNEL_NAME=authserver   # name of the ngrok tunnel (default: authserver)
# WAIT_ATTEMPTS=10         # retry attempts before the container aborts (default: 10)
# WAIT_INTERVAL=3          # seconds between retries (default: 3)